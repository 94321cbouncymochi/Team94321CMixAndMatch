{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nleft_drive_smart = Motor(Ports.PORT7, 1.0, False)\nright_drive_smart = Motor(Ports.PORT12, 1.0, True)\n\ndrivetrain = SmartDrive(left_drive_smart, right_drive_smart, brain_inertial, 200)\npin_claw_lifter_motor_a = Motor(Ports.PORT1, True)\npin_claw_lifter_motor_b = Motor(Ports.PORT6, False)\npin_claw_lifter = MotorGroup(pin_claw_lifter_motor_a, pin_claw_lifter_motor_b)\nbeam_claw_lifter_motor_a = Motor(Ports.PORT5, True)\nbeam_claw_lifter_motor_b = Motor(Ports.PORT2, False)\nbeam_claw_lifter = MotorGroup(beam_claw_lifter_motor_a, beam_claw_lifter_motor_b)\nonewiththebeamclaw = Pneumatic(Ports.PORT3)\ntheonewithrightclaw = Pneumatic(Ports.PORT4)\ncontroller = Controller()\nL_distance = Distance(Ports.PORT8)\nR_distance = Distance(Ports.PORT11)\nback_distance = Distance(Ports.PORT10)\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\nvexcode_initial_drivetrain_calibration_completed = False\ndef calibrate_drivetrain():\n    # Calibrate the Drivetrain Inertial\n    global vexcode_initial_drivetrain_calibration_completed\n    if not vexcode_initial_drivetrain_calibration_completed:\n        onewiththebeamclaw.pump_off()\n        theonewithrightclaw.pump_off()\n    sleep(200, MSEC)\n    brain.screen.print(\"Calibrating\")\n    brain.screen.next_row()\n    brain.screen.print(\"Inertial\")\n    brain_inertial.calibrate()\n    while brain_inertial.is_calibrating():\n        sleep(25, MSEC)\n    if not vexcode_initial_drivetrain_calibration_completed:\n        onewiththebeamclaw.pump_on()\n        theonewithrightclaw.pump_on()\n    vexcode_initial_drivetrain_calibration_completed = True\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n\n\n# Calibrate the Drivetrain\ncalibrate_drivetrain()\n\n\n\n# define variables used for controlling motors based on controller inputs\ndrivetrain_l_needs_to_be_stopped_controller = False\ndrivetrain_r_needs_to_be_stopped_controller = False\n\n# define a task that will handle monitoring inputs from controller\ndef rc_auto_loop_function_controller():\n    global drivetrain_l_needs_to_be_stopped_controller, drivetrain_r_needs_to_be_stopped_controller, remote_control_code_enabled\n    # process the controller input every 20 milliseconds\n    # update the motors based on the input values\n    while True:\n        if remote_control_code_enabled:\n            \n            # calculate the drivetrain motor velocities from the controller joystick axies\n            # left = axisA + axisC\n            # right = axisA - axisC\n            drivetrain_left_side_speed = controller.axisA.position() + controller.axisC.position()\n            drivetrain_right_side_speed = controller.axisA.position() - controller.axisC.position()\n            \n            # check if the value is inside of the deadband range\n            if drivetrain_left_side_speed < 5 and drivetrain_left_side_speed > -5:\n                # check if the left motor has already been stopped\n                if drivetrain_l_needs_to_be_stopped_controller:\n                    # stop the left drive motor\n                    left_drive_smart.stop()\n                    # tell the code that the left motor has been stopped\n                    drivetrain_l_needs_to_be_stopped_controller = False\n            else:\n                # reset the toggle so that the deadband code knows to stop the left motor next\n                # time the input is in the deadband range\n                drivetrain_l_needs_to_be_stopped_controller = True\n            # check if the value is inside of the deadband range\n            if drivetrain_right_side_speed < 5 and drivetrain_right_side_speed > -5:\n                # check if the right motor has already been stopped\n                if drivetrain_r_needs_to_be_stopped_controller:\n                    # stop the right drive motor\n                    right_drive_smart.stop()\n                    # tell the code that the right motor has been stopped\n                    drivetrain_r_needs_to_be_stopped_controller = False\n            else:\n                # reset the toggle so that the deadband code knows to stop the right motor next\n                # time the input is in the deadband range\n                drivetrain_r_needs_to_be_stopped_controller = True\n            \n            # only tell the left drive motor to spin if the values are not in the deadband range\n            if drivetrain_l_needs_to_be_stopped_controller:\n                left_drive_smart.set_velocity(drivetrain_left_side_speed, PERCENT)\n                left_drive_smart.spin(FORWARD)\n            # only tell the right drive motor to spin if the values are not in the deadband range\n            if drivetrain_r_needs_to_be_stopped_controller:\n                right_drive_smart.set_velocity(drivetrain_right_side_speed, PERCENT)\n                right_drive_smart.spin(FORWARD)\n        # wait before repeating the process\n        wait(20, MSEC)\n\n# define variable for remote controller enable/disable\nremote_control_code_enabled = True\n\nrc_auto_loop_thread_controller = Thread(rc_auto_loop_function_controller)\n\n#endregion VEXcode Generated Robot Configuration\ndef clear_console():\n    print(\"\\033[2J\")\n\ndef openpinalign():\n    theonewithrightclaw.retract(CYLINDER1)\n\n\ndef config():\n    #drive config\n    drivetrain.set_stopping(BRAKE)\n    drivetrain.set_drive_velocity(65, PERCENT)\n    drivetrain.set_turn_velocity(65, PERCENT)\n    #Pump config\n    onewiththebeamclaw.pump_on()\n    theonewithrightclaw.pump_on()\n    #Lifter config\n    pin_claw_lifter.set_velocity(75, PERCENT)\n    beam_claw_lifter.set_velocity(40, PERCENT)\n    pin_claw_lifter.set_max_torque(100, PERCENT)\n    beam_claw_lifter.set_max_torque(100, PERCENT)\n    pin_claw_lifter.set_stopping(BRAKE)\n    beam_claw_lifter.set_stopping(HOLD)\n    #Claw config\n    onewiththebeamclaw.extend(CYLINDER1)\n    theonewithrightclaw.retract(CYLINDER2)\n    onewiththebeamclaw.extend(CYLINDER2)\n    openpinalign()\n\n\ndef openright():\n    theonewithrightclaw.retract(CYLINDER2)\n\n\ndef openleft():\n    onewiththebeamclaw.retract(CYLINDER1)\n\n\ndef openbeam():\n    onewiththebeamclaw.extend(CYLINDER2)\n\ndef closeright():\n    theonewithrightclaw.extend(CYLINDER2)\n\n\ndef closeleft():\n    onewiththebeamclaw.extend(CYLINDER1)\n\ndef closebeam():\n    onewiththebeamclaw.retract(CYLINDER2)\n\n\ndef closepinalign():\n    theonewithrightclaw.extend(CYLINDER1)\n\ndef reset():\n    openright()\n    openleft()\n    openbeam()\n    openpinalign()\n    brain.program_stop()\n\n\ndef grab_right():\n    while True:\n        if R_distance.object_distance(MM) > 50:\n            #Play a sound if it can't see the pin\n            brain.play_sound(SoundType.SIREN)\n            #Drive forward, but make it slower\n            drivetrain.drive(FORWARD)\n            drivetrain.set_drive_velocity(50, PERCENT)\n        else:\n            #Stop moving\n            drivetrain.stop()\n            #Set the velocity back\n            drivetrain.set_drive_velocity(65, PERCENT)\n            #Clost the claw\n            closeright()\n            #Sound\n            brain.play_sound(SoundType.RATCHET)\n            break\n\n\ndef grab_left():\n    while True:\n        if L_distance.object_distance(MM) > 50:\n            #Play a sound if it can't see the pin\n            brain.play_sound(SoundType.SIREN)\n            #Drive forward, but make it slower\n            drivetrain.drive(FORWARD)\n            drivetrain.set_drive_velocity(50, PERCENT)\n        else:\n            #Stop moving\n            drivetrain.stop()\n            #Set the velocity back\n            drivetrain.set_drive_velocity(65, PERCENT)\n            #Clost the claw\n            closeleft()\n            #Sound\n            brain.play_sound(SoundType.RATCHET)\n            break\n\n\ndef flip():\n    #Flip the pins\n    pin_claw_lifter.set_timeout(2, SECONDS)\n    pin_claw_lifter.spin_for(REVERSE, 700, DEGREES)\n    wait(1, SECONDS)\n    #Open the claws\n    openright()\n    openleft()\n    pin_claw_lifter.set_timeout(2, SECONDS)\n    pin_claw_lifter.spin_to_position(40, DEGREES)\n\n\ndef halfup_right():\n    pin_claw_lifter.spin_for(REVERSE, 320, DEGREES)\n\ndef halfdown_right():\n    pin_claw_lifter.set_timeout(1, SECONDS)\n    pin_claw_lifter.spin_for(FORWARD, 330, DEGREES)\n\n\ndef beamlifterup():\n    beam_claw_lifter.spin_for(REVERSE, 300, DEGREES)\n\n\ndef beamlifterdown():\n    beam_claw_lifter.spin_for(FORWARD, 40, DEGREES)\n\n    \ndef when_started1():\n    debug_mode = 0\n    while not brain.buttonCheck.pressing():\n        if brain.buttonLeft.pressing():\n            debug_mode = 1\n            \n    brain.timer.clear()\n    clear_console()\n    print(\"Pre detection started \" + str(brain.timer.time(SECONDS)))\n    if L_distance.object_distance(MM) <= 50:\n        print(\"Preload detected \" + str(brain.timer.time(SECONDS)))\n    else:\n        print(\"Preload missing \" + str(brain.timer.time(SECONDS)))\n        brain.play_sound(SoundType.ALARM)\n        brain.program_stop()\n    print(\"Program started \" + str(brain.timer.time(SECONDS))) #log when the program starts\n    drivetrain.turn_for(RIGHT, 3, DEGREES)\n    drivetrain.drive_for(FORWARD, 1100, MM,wait=True) #drive foreward to the first blue pin\n    grab_right() #grab the blue pin\n    if R_distance.object_distance(MM) <= 50: #if the blue pin is detected then log, if not then also log\n        print(\"Blue pin grabbed \" + str(brain.timer.time(SECONDS)))\n    else:\n        print(\"Error: Blue pin not detected \" + str(brain.timer.time(SECONDS)))\n        brain.play_sound(SoundType.ALARM)\n        brain.program_stop()\n    print(\"heading to beam \" + str(brain.timer.time(SECONDS)))\n    drivetrain.drive_for(REVERSE, 150, MM,wait=True)\n    drivetrain.turn_to_heading(90, DEGREES)\n    drivetrain.drive_for(FORWARD, 820.4, MM,wait=True)\n    drivetrain.turn_for(RIGHT, 90, DEGREES,wait=True)\n    print(\"Check for if robot at beam position \" + str(brain.timer.time(SECONDS)))\n    if debug_mode == 1:\n        while not brain.buttonLeft.pressing():\n            pass\n    print(\"Beam reached \" + str(brain.timer.time(SECONDS)))\n    drivetrain.set_timeout(0.5, SECONDS)\n    drivetrain.drive_for(REVERSE, 500, MM,wait=True)\n    print(\"Backed up into beam \" + str(brain.timer.time(SECONDS)))\n    if debug_mode == 1:\n        while not brain.buttonLeft.pressing():\n            pass\n    closebeam()\n    print(\"Beam grabbed \" + str(brain.timer.time(SECONDS)))\n    flip()\n    print(\"Flipped \" + str(brain.timer.time(SECONDS)))\n    drivetrain.drive_for(FORWARD, 25, MM, wait=True)\n    drivetrain.turn_for(LEFT, 90, DEGREES, wait=True)\n    print(\"Headed toward next two pins \" + str(brain.timer.time(SECONDS)))    \n    grab_right()\n    grab_left()\n    if L_distance.object_distance(MM) <= 50 and R_distance.object_distance(MM) <= 50:\n        print(\"Yay! \" + str(brain.timer.time(SECONDS)))\n    else:\n        print(\"I failed \" + str(brain.timer.time(SECONDS)))\n        brain.program_stop()\n    flip()\n    print(\"I think I have 4 pins on the beam XD\"  + str(brain.timer.time(SECONDS)))\n    wait(1, SECONDS)\n    reset()\n    \n\n    \n\n#reset the system\ndef when_started2():\n    while True:\n        if brain.buttonRight.pressing():\n            reset()\n\nconfig()\nws2 = Thread( when_started2 )\nwhen_started1()","textLanguage":"python","robotConfig":[{"port":[7,12,0],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"200mm","gearRatio":"1:1","direction":"fwd","gyroType":"integrated","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[1,6],"name":"pin_claw_lifter","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[5,2],"name":"beam_claw_lifter","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[3],"name":"onewiththebeamclaw","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"right_claw","cylinder2":"beam_claw","cylinder1_reversed":"false","cylinder2_reversed":"false"},"triportSourcePort":22},{"port":[4],"name":"theonewithrightclaw","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"nothing","cylinder2":"left_claw","cylinder1_reversed":"false","cylinder2_reversed":"false"},"triportSourcePort":22},{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"true","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"split"},"triportSourcePort":22},{"port":[8],"name":"L_distance","customName":true,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22},{"port":[11],"name":"R_distance","customName":true,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22},{"port":[10],"name":"back_distance","customName":true,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22}],"slot":1,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.62.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}