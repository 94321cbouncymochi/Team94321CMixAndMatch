{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nleft_drive_smart = Motor(Ports.PORT7, 1.0, False)\nright_drive_smart = Motor(Ports.PORT12, 1.0, True)\ndrivetrain = DriveTrain(left_drive_smart, right_drive_smart, 200, 173, 76, MM, 1)\npin_claw_lifter_motor_a = Motor(Ports.PORT1, True)\npin_claw_lifter_motor_b = Motor(Ports.PORT6, False)\npin_claw_lifter = MotorGroup(pin_claw_lifter_motor_a, pin_claw_lifter_motor_b)\nbeam_claw_lifter_motor_a = Motor(Ports.PORT5, True)\nbeam_claw_lifter_motor_b = Motor(Ports.PORT2, False)\nbeam_claw_lifter = MotorGroup(beam_claw_lifter_motor_a, beam_claw_lifter_motor_b)\nprimary_pneumatics = Pneumatic(Ports.PORT3)\nsecondary_pneumatics = Pneumatic(Ports.PORT4)\ncontroller = Controller()\nLeft_distances = Distance(Ports.PORT8)\nRight_distance = Distance(Ports.PORT11)\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n\n\n# define variables used for controlling motors based on controller inputs\ndrivetrain_l_needs_to_be_stopped_controller = False\ndrivetrain_r_needs_to_be_stopped_controller = False\n\n# define a task that will handle monitoring inputs from controller\ndef rc_auto_loop_function_controller():\n    global drivetrain_l_needs_to_be_stopped_controller, drivetrain_r_needs_to_be_stopped_controller, remote_control_code_enabled\n    # process the controller input every 20 milliseconds\n    # update the motors based on the input values\n    while True:\n        if remote_control_code_enabled:\n            \n            # calculate the drivetrain motor velocities from the controller joystick axies\n            # left = axisA + axisC\n            # right = axisA - axisC\n            drivetrain_left_side_speed = controller.axisA.position() + controller.axisC.position()\n            drivetrain_right_side_speed = controller.axisA.position() - controller.axisC.position()\n            \n            # check if the value is inside of the deadband range\n            if drivetrain_left_side_speed < 5 and drivetrain_left_side_speed > -5:\n                # check if the left motor has already been stopped\n                if drivetrain_l_needs_to_be_stopped_controller:\n                    # stop the left drive motor\n                    left_drive_smart.stop()\n                    # tell the code that the left motor has been stopped\n                    drivetrain_l_needs_to_be_stopped_controller = False\n            else:\n                # reset the toggle so that the deadband code knows to stop the left motor next\n                # time the input is in the deadband range\n                drivetrain_l_needs_to_be_stopped_controller = True\n            # check if the value is inside of the deadband range\n            if drivetrain_right_side_speed < 5 and drivetrain_right_side_speed > -5:\n                # check if the right motor has already been stopped\n                if drivetrain_r_needs_to_be_stopped_controller:\n                    # stop the right drive motor\n                    right_drive_smart.stop()\n                    # tell the code that the right motor has been stopped\n                    drivetrain_r_needs_to_be_stopped_controller = False\n            else:\n                # reset the toggle so that the deadband code knows to stop the right motor next\n                # time the input is in the deadband range\n                drivetrain_r_needs_to_be_stopped_controller = True\n            \n            # only tell the left drive motor to spin if the values are not in the deadband range\n            if drivetrain_l_needs_to_be_stopped_controller:\n                left_drive_smart.set_velocity(drivetrain_left_side_speed, PERCENT)\n                left_drive_smart.spin(FORWARD)\n            # only tell the right drive motor to spin if the values are not in the deadband range\n            if drivetrain_r_needs_to_be_stopped_controller:\n                right_drive_smart.set_velocity(drivetrain_right_side_speed, PERCENT)\n                right_drive_smart.spin(FORWARD)\n        # wait before repeating the process\n        wait(20, MSEC)\n\n# define variable for remote controller enable/disable\nremote_control_code_enabled = True\n\nrc_auto_loop_thread_controller = Thread(rc_auto_loop_function_controller)\n\n#endregion VEXcode Generated Robot Configuration\n\n#Variable config\nleft_claw = False\nright_claw = False\nbeam_claw_ = False\npin_lifter_in_air = False\nbeam_lifter_in_air = False\nleft_Distance_wait = 0\nRight_distance_wait = 0\n\n#Motor, pneumatic and distance wait config\ndef when_started1():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    # set up\n    left_Distance_wait = 3\n    Right_distance_wait = 3\n    pin_claw_lifter.set_stopping(HOLD)\n    beam_claw_lifter.set_stopping(HOLD)\n    drivetrain.set_stopping(BRAKE)\n    drivetrain.set_stopping(BRAKE)\n    drivetrain.set_drive_velocity(65, PERCENT)\n    drivetrain.set_turn_velocity(65, PERCENT)\n    primary_pneumatics.pump_on()\n    secondary_pneumatics.pump_on()\n    pin_claw_lifter.set_velocity(75, PERCENT)\n    beam_claw_lifter.set_velocity(40, PERCENT)\n    pin_claw_lifter.set_max_torque(100, PERCENT)\n    beam_claw_lifter.set_max_torque(100, PERCENT)\n    primary_pneumatics.retract(CYLINDER1)\n    secondary_pneumatics.retract(CYLINDER2)\n    primary_pneumatics.extend(CYLINDER2)\n    beam_claw_ = False\n    right_claw = True\n    left_claw = True\n    beam_lifter_in_air = False\n    pin_lifter_in_air = False\n\n#Left pin claw toggle\ndef controllerbuttonFDown_pressed_callback_0():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    # left pin claw\n    left_Distance_wait = 0\n    #toggle code\n    if left_claw:\n        left_claw = False\n        secondary_pneumatics.extend(CYLINDER2)\n    else:\n        left_claw = True\n        secondary_pneumatics.retract(CYLINDER2)\n\n#Right claw toggle\ndef controllerbuttonFUp_pressed_callback_0():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    # right pin claw\n    Right_distance_wait = 0\n    #toggle code\n    if right_claw:\n        right_claw = False\n        primary_pneumatics.extend(CYLINDER1)\n    else:\n        right_claw = True\n        primary_pneumatics.retract(CYLINDER1)\n\n#beam claw toggle\ndef controllerbuttonEUp_pressed_callback_0():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    # toggle\n    if beam_claw_:\n        beam_claw_ = False\n        primary_pneumatics.extend(CYLINDER2)\n    else:\n        beam_claw_ = True\n        primary_pneumatics.retract(CYLINDER2)\n\ndef controllerbuttonRUp_pressed_callback_0():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    # pin auto lift\n    if pin_lifter_in_air:\n        #If the pin lifter is in the air, it won't go up anymore, it will spin down to the original starting position.\n        pin_claw_lifter.spin_to_position(0, DEGREES)\n        primary_pneumatics.retract(CYLINDER1)\n        secondary_pneumatics.retract(CYLINDER2)\n        pin_lifter_in_air = False\n        right_claw = True\n        left_claw = True\n    elif not pin_lifter_in_air:\n        #If the pin lifter is not in the air, it will spin up 180 degrees, excluding the gear ratio, which means it won't be straight up, and it will be only a little bit up.\n        primary_pneumatics.extend(CYLINDER1)\n        secondary_pneumatics.extend(CYLINDER2)\n        pin_claw_lifter.spin_for(REVERSE, 180, DEGREES)\n        pin_lifter_in_air = True\n        left_claw = False\n        right_claw = False\n    else:\n        pass\n\n#This code flips the pins\ndef controllerbuttonEDown_pressed_callback_0():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    # pin auto flip\n    primary_pneumatics.extend(CYLINDER1)\n    secondary_pneumatics.extend(CYLINDER2)\n    beam_claw_lifter.spin_for(REVERSE, 15, DEGREES, wait=False)\n    #Sets a timeout in case the pin flip gets stuck.\n    pin_claw_lifter.set_timeout(1.5, SECONDS)\n    #Spins the flipper back.\n    pin_claw_lifter.spin_for(REVERSE, 750, DEGREES)\n    left_claw = False\n    right_claw = False\n    wait(0.2, SECONDS)\n    #opens the pneumatics\n    primary_pneumatics.retract(CYLINDER1)\n    secondary_pneumatics.retract(CYLINDER2)\n    beam_claw_lifter.spin_to_position(0, DEGREES)\n    pin_claw_lifter.spin_to_position(0, DEGREES)\n    right_claw = True\n    left_claw = True\n\n\n#This is extra code and Austin won't tell me what it is about.\ndef controllerbuttonRDown_pressed_callback_0():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    # pin auto flip ho ho ho\n    primary_pneumatics.extend(CYLINDER1)\n    secondary_pneumatics.extend(CYLINDER2)\n    beam_claw_lifter.spin_for(REVERSE, 15, DEGREES, wait=False)\n    pin_claw_lifter.set_timeout(1.5, SECONDS)\n    pin_claw_lifter.spin_for(REVERSE, 540, DEGREES)\n    left_claw = False\n    right_claw = False\n    while not beam_claw_:\n        wait(20, MSEC)\n    wait(0.1, SECONDS)\n    pin_claw_lifter.spin_for(REVERSE, 210, DEGREES)\n    wait(0.01, SECONDS)\n    primary_pneumatics.retract(CYLINDER1)\n    secondary_pneumatics.retract(CYLINDER2)\n    beam_claw_lifter.spin_to_position(0, DEGREES)\n    pin_claw_lifter.spin_to_position(0, DEGREES)\n    right_claw = True\n    left_claw = True\n\n#The distance sensor\ndef when_started2():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    while True:\n        if Left_distances.object_distance(INCHES) < 1.9:\n            primary_pneumatics.extend(CYLINDER1)\n            left_claw = False\n        if Right_distance.object_distance(INCHES) < 1.9:\n            secondary_pneumatics.extend(CYLINDER2)\n            right_claw = False\n        wait(20, MSEC)\n#This makes sure the beam doesn't interfere with the pin flipper\ndef controllerbuttonLUp_pressed_callback_0():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    beam_claw_lifter.spin(REVERSE)\n    while not (not controller.buttonLUp.pressing() or beam_claw_lifter.position(DEGREES) <= -330):\n        wait(20, MSEC)\n    beam_claw_lifter.stop()\n#This changes the distance wait forever\ndef when_started3():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    while True:\n        left_Distance_wait = left_Distance_wait + 1\n        Right_distance_wait = Right_distance_wait + 1\n        wait(1, SECONDS)\n        wait(20, MSEC)\n#This spins the beam claw lifter\ndef controllerbuttonLDown_pressed_callback_0():\n    global left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, left_Distance_wait, Right_distance_wait\n    beam_claw_lifter.spin(FORWARD)\n    while not (not controller.buttonLDown.pressing() or beam_claw_lifter.position(DEGREES) >= 0):\n        wait(20, MSEC)\n    beam_claw_lifter.stop()\n\n# system event handlers\ncontroller.buttonFDown.pressed(controllerbuttonFDown_pressed_callback_0)\ncontroller.buttonFUp.pressed(controllerbuttonFUp_pressed_callback_0)\ncontroller.buttonEUp.pressed(controllerbuttonEUp_pressed_callback_0)\ncontroller.buttonRUp.pressed(controllerbuttonRUp_pressed_callback_0)\ncontroller.buttonEDown.pressed(controllerbuttonEDown_pressed_callback_0)\ncontroller.buttonRDown.pressed(controllerbuttonRDown_pressed_callback_0)\ncontroller.buttonLUp.pressed(controllerbuttonLUp_pressed_callback_0)\ncontroller.buttonLDown.pressed(controllerbuttonLDown_pressed_callback_0)\n# add 15ms delay to make sure events are registered correctly.\nwait(15, MSEC)\n\n#Finally, run all the code!\nws2 = Thread( when_started2 )\nws3 = Thread( when_started3 )\nwhen_started1()\n","textLanguage":"python","robotConfig":[{"port":[7,12,0],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"200mm","gearRatio":"1:1","direction":"fwd","gyroType":"none","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[1,6],"name":"pin_claw_lifter","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[5,2],"name":"beam_claw_lifter","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[3],"name":"primary_pneumatics","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"left_claw","cylinder2":"beam_claw","cylinder1_reversed":"false","cylinder2_reversed":"false"},"triportSourcePort":22},{"port":[4],"name":"secondary_pneumatics","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"nothing","cylinder2":"right_claw","cylinder1_reversed":"false","cylinder2_reversed":"false"},"triportSourcePort":22},{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"true","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"split"},"triportSourcePort":22},{"port":[8],"name":"Left_distances","customName":true,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22},{"port":[11],"name":"Right_distance","customName":true,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.61.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}