{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nleft_drive_smart = Motor(Ports.PORT7, 1.0, False)\nright_drive_smart = Motor(Ports.PORT12, 1.0, True)\ndrivetrain = DriveTrain(left_drive_smart, right_drive_smart, 200, 173, 76, MM, 1)\npin_claw_lifter_motor_a = Motor(Ports.PORT1, True)\npin_claw_lifter_motor_b = Motor(Ports.PORT6, False)\npin_claw_lifter = MotorGroup(pin_claw_lifter_motor_a, pin_claw_lifter_motor_b)\nbeam_claw_lifter_motor_a = Motor(Ports.PORT5, True)\nbeam_claw_lifter_motor_b = Motor(Ports.PORT2, False)\nbeam_claw_lifter = MotorGroup(beam_claw_lifter_motor_a, beam_claw_lifter_motor_b)\nprimary_pneumatics = Pneumatic(Ports.PORT3)\nsecondary_pneumatics = Pneumatic(Ports.PORT4)\nRight_distance = Distance(Ports.PORT11)\nLeft_distance = Distance(Ports.PORT8)\ncontroller = Controller()\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n\n\n# define variables used for controlling motors based on controller inputs\ndrivetrain_l_needs_to_be_stopped_controller = False\ndrivetrain_r_needs_to_be_stopped_controller = False\n\n# define a task that will handle monitoring inputs from controller\ndef rc_auto_loop_function_controller():\n    global drivetrain_l_needs_to_be_stopped_controller, drivetrain_r_needs_to_be_stopped_controller, remote_control_code_enabled\n    # process the controller input every 20 milliseconds\n    # update the motors based on the input values\n    while True:\n        if remote_control_code_enabled:\n            \n            # calculate the drivetrain motor velocities from the controller joystick axies\n            # left = axisA + axisC\n            # right = axisA - axisC\n            drivetrain_left_side_speed = controller.axisA.position() + controller.axisC.position()\n            drivetrain_right_side_speed = controller.axisA.position() - controller.axisC.position()\n            \n            # check if the value is inside of the deadband range\n            if drivetrain_left_side_speed < 5 and drivetrain_left_side_speed > -5:\n                # check if the left motor has already been stopped\n                if drivetrain_l_needs_to_be_stopped_controller:\n                    # stop the left drive motor\n                    left_drive_smart.stop()\n                    # tell the code that the left motor has been stopped\n                    drivetrain_l_needs_to_be_stopped_controller = False\n            else:\n                # reset the toggle so that the deadband code knows to stop the left motor next\n                # time the input is in the deadband range\n                drivetrain_l_needs_to_be_stopped_controller = True\n            # check if the value is inside of the deadband range\n            if drivetrain_right_side_speed < 5 and drivetrain_right_side_speed > -5:\n                # check if the right motor has already been stopped\n                if drivetrain_r_needs_to_be_stopped_controller:\n                    # stop the right drive motor\n                    right_drive_smart.stop()\n                    # tell the code that the right motor has been stopped\n                    drivetrain_r_needs_to_be_stopped_controller = False\n            else:\n                # reset the toggle so that the deadband code knows to stop the right motor next\n                # time the input is in the deadband range\n                drivetrain_r_needs_to_be_stopped_controller = True\n            \n            # only tell the left drive motor to spin if the values are not in the deadband range\n            if drivetrain_l_needs_to_be_stopped_controller:\n                left_drive_smart.set_velocity(drivetrain_left_side_speed, PERCENT)\n                left_drive_smart.spin(FORWARD)\n            # only tell the right drive motor to spin if the values are not in the deadband range\n            if drivetrain_r_needs_to_be_stopped_controller:\n                right_drive_smart.set_velocity(drivetrain_right_side_speed, PERCENT)\n                right_drive_smart.spin(FORWARD)\n        # wait before repeating the process\n        wait(20, MSEC)\n\n# define variable for remote controller enable/disable\nremote_control_code_enabled = True\n\nrc_auto_loop_thread_controller = Thread(rc_auto_loop_function_controller)\n\n#endregion VEXcode Generated Robot Configuration\n\nleft_Distance_wait = 0\nRight_distance_wait = 0\nleft_claw = False\nright_claw = False\nbeam_claw_ = False\npin_lifter_in_air = False\nbeam_lifter_in_air = False\nback_pin = False\ni = 0\n\ndef when_started1():\n    global left_Distance_wait, Right_distance_wait, left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, back_pin\n    # set up\n    pin_claw_lifter.set_stopping(HOLD)\n    beam_claw_lifter.set_stopping(HOLD)\n    drivetrain.set_stopping(HOLD)\n    drivetrain.set_stopping(BRAKE)\n    drivetrain.set_drive_velocity(100, PERCENT)\n    drivetrain.set_turn_velocity(100, PERCENT)\n    primary_pneumatics.pump_on()\n    secondary_pneumatics.pump_on()\n    pin_claw_lifter.set_velocity(100, PERCENT)\n    beam_claw_lifter.set_velocity(40, PERCENT)\n    pin_claw_lifter.set_max_torque(100, PERCENT)\n    beam_claw_lifter.set_max_torque(100, PERCENT)\n    primary_pneumatics.extend(CYLINDER1)\n    primary_pneumatics.extend(CYLINDER2)\n    secondary_pneumatics.retract(CYLINDER1)\n    primary_pneumatics.retract(CYLINDER1)\n    beam_claw_ = False\n    right_claw = True\n    left_claw = True\n    beam_lifter_in_air = False\n    pin_lifter_in_air = False\n    back_pin = True\n\ndef controllerbuttonFUp_pressed_callback_0():\n    global left_Distance_wait, Right_distance_wait, left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, back_pin\n    # right pin claw\n    Right_distance_wait = brain.timer.time(SECONDS) + 3\n    if right_claw:\n        right_claw = False\n        primary_pneumatics.extend(CYLINDER2)\n    else:\n        right_claw = True\n        primary_pneumatics.retract(CYLINDER2)\n\ndef controllerbuttonFDown_pressed_callback_0():\n    global left_Distance_wait, Right_distance_wait, left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, back_pin\n    # left pin claw\n    left_Distance_wait = brain.timer.time(SECONDS) + 3\n    if left_claw:\n        left_claw = False\n        primary_pneumatics.extend(CYLINDER1)\n    else:\n        left_claw = True\n        primary_pneumatics.retract(CYLINDER1)\n\ndef controllerbuttonEUp_pressed_callback_0():\n    global left_Distance_wait, Right_distance_wait, left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, back_pin\n    # beam pin claw\n    if beam_claw_:\n        beam_claw_ = False\n        secondary_pneumatics.retract(CYLINDER1)\n    else:\n        beam_claw_ = True\n        secondary_pneumatics.extend(CYLINDER1)\n\ndef controllerbuttonEDown_pressed_callback_0():\n    global left_Distance_wait, Right_distance_wait, left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, back_pin\n    # pin auto flip\n    primary_pneumatics.retract(CYLINDER1)\n    primary_pneumatics.retract(CYLINDER2)\n    beam_claw_lifter.spin_for(REVERSE, 15, DEGREES, wait=False)\n    pin_claw_lifter.set_timeout(1.5, SECONDS)\n    pin_claw_lifter.spin_for(REVERSE, 750, DEGREES)\n    left_claw = False\n    right_claw = False\n    wait(0.2, SECONDS)\n    primary_pneumatics.extend(CYLINDER1)\n    primary_pneumatics.extend(CYLINDER2)\n    beam_claw_lifter.spin_to_position(0, DEGREES)\n    pin_claw_lifter.spin_to_position(0, DEGREES)\n    right_claw = True\n    left_claw = True\n\ndef controllerbuttonRUp_pressed_callback_0():\n    global left_Distance_wait, Right_distance_wait, left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, back_pin\n    # pin auto lift\n    if pin_lifter_in_air:\n        pin_claw_lifter.spin_to_position(0, DEGREES)\n        left_Distance_wait = brain.timer.time(SECONDS) + 3\n        Right_distance_wait = brain.timer.time(SECONDS) + 3\n        primary_pneumatics.extend(CYLINDER1)\n        primary_pneumatics.extend(CYLINDER2)\n        pin_lifter_in_air = False\n        right_claw = True\n        left_claw = True\n    elif not pin_lifter_in_air:\n        primary_pneumatics.retract(CYLINDER1)\n        primary_pneumatics.retract(CYLINDER2)\n        # 235 degrees, gear ratio too loose so it isn't lifting high enough. NO THREE STACKS!!!\n        pin_claw_lifter.spin_for(REVERSE, 235, DEGREES)\n        pin_lifter_in_air = True\n        left_claw = False\n        right_claw = False\n    else:\n        pass\n\ndef when_started2():\n    global left_Distance_wait, Right_distance_wait, left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, back_pin\n    #  pin sencer close\n    while True:\n        if pin_claw_lifter.position(DEGREES) >= -15 and Right_distance.object_distance(MM) <= 31 and brain.timer.time(SECONDS) >= Right_distance_wait:\n            if right_claw:\n                brain.play_sound(SoundType.TADA)\n            primary_pneumatics.retract(CYLINDER2)\n            right_claw = False\n        if pin_claw_lifter.position(DEGREES) >= -15 and Left_distance.object_distance(MM) <= 31 and brain.timer.time(SECONDS) >= left_Distance_wait:\n            if left_claw:\n                brain.play_sound(SoundType.TADA)\n            primary_pneumatics.retract(CYLINDER1)\n            left_claw = False\n        wait(20, MSEC)\n\ndef controllerbuttonRDown_pressed_callback_0():\n    global left_Distance_wait, Right_distance_wait, left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, back_pin, remote_control_code_enabled\n    if beam_claw_ and (Right_distance.object_distance(MM)) <= 31 or (Left_distance.object_distance(MM)) <= 31:\n        brain.play_sound(SoundType.HEADLIGHTS_OFF)\n        secondary_pneumatics.extend(CYLINDER1)\n        #remote_control_code_enabled = False\n        drivetrain.set_turn_velocity(50, PERCENT)\n        drivetrain.set_drive_velocity(50, PERCENT)\n        if Right_distance.object_distance(MM) <= 31:\n            primary_pneumatics.extend(CYLINDER2)\n            Right_distance_wait = brain.timer.time(SECONDS) + 3\n            drivetrain.drive_for(REVERSE, 120, MM)\n            beam_claw_lifter.spin_for(REVERSE, 300, DEGREES, wait=True)\n            drivetrain.turn_for(LEFT, 170, DEGREES)\n        else:\n            primary_pneumatics.extend(CYLINDER1)\n            left_Distance_wait = brain.timer.time(SECONDS) + 3\n            drivetrain.drive_for(REVERSE, 120, MM)\n            beam_claw_lifter.spin_for(REVERSE, 300, DEGREES, wait=True)\n            drivetrain.turn_for(RIGHT, 170, DEGREES)\n        secondary_pneumatics.extend(CYLINDER2)\n        drivetrain.drive_for(REVERSE, 320, MM)\n        drivetrain.drive_for(FORWARD, 15, MM)\n        beam_claw_lifter.set_timeout(0.25, SECONDS)\n        beam_claw_lifter.spin_for(FORWARD, 40, DEGREES)\n        #what the fucking fuck this fucking doesn't work fuck this fucking code\n\n        secondary_pneumatics.retract(CYLINDER1)\n        secondary_pneumatics.retract(CYLINDER2)\n        wait(1, SECONDS)\n        beam_claw_lifter.set_timeout(0.25, SECONDS)\n        beam_claw_lifter.spin_for(REVERSE, 40, DEGREES)\n        drivetrain.set_drive_velocity(100, PERCENT)\n        drivetrain.drive_for(FORWARD, 200, MM, wait=False)\n        wait(0.2, SECONDS)\n        beam_claw_lifter.set_timeout(2, SECONDS)\n        beam_claw_lifter.spin_to_position(0, DEGREES)\n        brain.play_sound(SoundType.TADA)\n        #remote_control_code_enabled = True\n    brain.play_sound(SoundType.HEADLIGHTS_ON)\n\ndef controllerbuttonLUp_pressed_callback_0():\n    global left_Distance_wait, Right_distance_wait, left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, back_pin\n    beam_claw_lifter.spin(REVERSE)\n    while not (not controller.buttonLUp.pressing() or beam_claw_lifter.position(DEGREES) <= -330):\n        wait(20, MSEC)\n    beam_claw_lifter.stop()\n\ndef controllerbuttonLDown_pressed_callback_0():\n    global left_Distance_wait, Right_distance_wait, left_claw, right_claw, beam_claw_, pin_lifter_in_air, beam_lifter_in_air, back_pin\n    beam_claw_lifter.spin(FORWARD)\n    while not (not controller.buttonLDown.pressing() or beam_claw_lifter.position(DEGREES) >= 0):\n        wait(20, MSEC)\n    beam_claw_lifter.stop()\n\n# system event handlers\ncontroller.buttonFUp.pressed(controllerbuttonFUp_pressed_callback_0)\ncontroller.buttonFDown.pressed(controllerbuttonFDown_pressed_callback_0)\ncontroller.buttonEUp.pressed(controllerbuttonEUp_pressed_callback_0)\ncontroller.buttonEDown.pressed(controllerbuttonEDown_pressed_callback_0)\ncontroller.buttonRUp.pressed(controllerbuttonRUp_pressed_callback_0)\ncontroller.buttonRDown.pressed(controllerbuttonRDown_pressed_callback_0)\ncontroller.buttonLUp.pressed(controllerbuttonLUp_pressed_callback_0)\ncontroller.buttonLDown.pressed(controllerbuttonLDown_pressed_callback_0)\n# add 15ms delay to make sure events are registered correctly.\nwait(15, MSEC)\n\nws2 = Thread( when_started2 )\nwhen_started1()\n","textLanguage":"python","robotConfig":[{"port":[7,12,0],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"200mm","gearRatio":"1:1","direction":"fwd","gyroType":"none","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[1,6],"name":"pin_claw_lifter","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[5,2],"name":"beam_claw_lifter","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[3],"name":"primary_pneumatics","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"left claw","cylinder2":"right claw","cylinder1_reversed":"false","cylinder2_reversed":"false"},"triportSourcePort":22},{"port":[4],"name":"secondary_pneumatics","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"beam claaw","cylinder2":"pin align","cylinder1_reversed":"false","cylinder2_reversed":"false"},"triportSourcePort":22},{"port":[11],"name":"Right_distance","customName":true,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22},{"port":[8],"name":"Left_distance","customName":true,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22},{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"split"},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.62.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}