{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\npinFlip_motor_a = Motor(Ports.PORT3, False)\npinFlip_motor_b = Motor(Ports.PORT9, True)\npinFlip = MotorGroup(pinFlip_motor_a, pinFlip_motor_b)\nbeamClawLift_motor_a = Motor(Ports.PORT6, True)\nbeamClawLift_motor_b = Motor(Ports.PORT12, False)\nbeamClawLift = MotorGroup(beamClawLift_motor_a, beamClawLift_motor_b)\nPrimary = Pneumatic(Ports.PORT2)\nSecondary = Pneumatic(Ports.PORT8)\nleft_drive_smart = Motor(Ports.PORT7, 2.0, True)\nright_drive_smart = Motor(Ports.PORT1, 2.0, False)\n\ndrivetrain = SmartDrive(left_drive_smart, right_drive_smart, brain_inertial, 200)\ncontroller = Controller()\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\nvexcode_initial_drivetrain_calibration_completed = False\ndef calibrate_drivetrain():\n    # Calibrate the Drivetrain Inertial\n    global vexcode_initial_drivetrain_calibration_completed\n    if not vexcode_initial_drivetrain_calibration_completed:\n        Primary.pump_off()\n        Secondary.pump_off()\n    sleep(200, MSEC)\n    brain.screen.print(\"Calibrating\")\n    brain.screen.next_row()\n    brain.screen.print(\"Inertial\")\n    brain_inertial.calibrate()\n    while brain_inertial.is_calibrating():\n        sleep(25, MSEC)\n    if not vexcode_initial_drivetrain_calibration_completed:\n        Primary.pump_on()\n        Secondary.pump_on()\n    vexcode_initial_drivetrain_calibration_completed = True\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n\n\n# Calibrate the Drivetrain\ncalibrate_drivetrain()\n\n#endregion VEXcode Generated Robot Configuration\n\n#region Comments\n'''\nPrimary pneumatics both slots are reverse\nA. Primary\n    1. Slot 1\n        a. Left claw\n    2. Slot 2\n        a. Beam claw\nB. Secondary\n    1. Slot 1\n        a. Right claw (Reversed)\n    2. Slot 2\n        a. N/A\n'''\n#304.8 mm in a foot\n#endregion\n\n#region Library imports\nfrom vex import *\n#endregion\n\n\n#region Variables\ndev = 0\npinFlipAngle = 0\nbeamLiftAngle = 0\n#endregion -----------------Variables---------------\n\n\n#region Development functions\ndef pause():\n    global dev\n    if dev == 1:\n        while not brain.buttonRight.pressing():\n            wait(1, MSEC)\n#Console logging function\ndef logconsole(message):\n    print(str(message) + \" \" + str(brain.timer.time(SECONDS)))\n\ndef logall():\n    global pinFlipAngle, beamLiftAngle\n    logconsole(str(pinFlipAngle) + \", \" + str(beamLiftAngle))\n#endregion\n\n#region Claw funtions\n\ndef openRightClaw():\n    Secondary.extend(CYLINDER1)\n\ndef closeRightClaw():\n    Secondary.retract(CYLINDER1)\n\ndef openLeftClaw():\n    Primary.retract(CYLINDER1)\n\ndef closeLeftClaw():\n    Primary.extend(CYLINDER1)\n\ndef openBeamClaw():\n    Primary.extend(CYLINDER2)\n\ndef closeBeamClaw():\n    Primary.retract(CYLINDER2)\n\n#endregion\n\n#region main\ndef run():\n    drivetrain.set_drive_velocity(100, PERCENT)\n    drivetrain.set_turn_velocity(30, PERCENT)\n    global dev, pinFlipAngle, beamLiftAngle\n    openRightClaw()\n    openLeftClaw()\n    openBeamClaw()\n    while not controller.buttonEUp.pressing():\n        if controller.buttonEDown.pressing():\n            dev = 1\n    print(\"\\33[2J\")\n    brain.timer.clear()\n    pause()\n    logconsole(\"Preload grabbed\")\n    closeRightClaw()\n    drivetrain.set_timeout(1.5, SECONDS)\n    drivetrain.drive_for(FORWARD, 1500, MM)\n    drivetrain.drive_for(REVERSE, 272.2, MM)\n    drivetrain.turn_for(RIGHT, 90, DEGREES)\n    openLeftClaw()\n    drivetrain.drive_for(FORWARD, 304.8, MM)\n    closeLeftClaw()\n\ndef variable():\n    global pinFlipAngle, beamLiftAngle\n    while True:\n        pinFlipAngle = pinFlip.position(DEGREES)\n        beamLiftAngle = beamClawLift.position(DEGREES)\n\n#endregion\n\n\n#Code start (main loop)\ndef mainLoop():\n    global dev, pinFlipAngle, beamLiftAngle\n    runMain = Thread(run)\n    Thread(variable)\n\n\nrunMainLoop = Thread(mainLoop)","textLanguage":"python","robotConfig":[{"port":[3,9],"name":"pinFlip","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"false","motor_b_reversed":"true"},"triportSourcePort":22},{"port":[6,12],"name":"beamClawLift","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[2],"name":"Primary","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"cylinder1","cylinder2":"cylinder2","cylinder1_reversed":"false","cylinder2_reversed":"false","cylinder3":"","cylinder4":""},"triportSourcePort":22},{"port":[8],"name":"Secondary","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"cylinder1","cylinder2":"cylinder2","cylinder1_reversed":"false","cylinder2_reversed":"false","cylinder3":"","cylinder4":""},"triportSourcePort":22},{"port":[7,1,0],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"200mm","gearRatio":"2:1","direction":"rev","gyroType":"integrated","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"}}],"slot":2,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.62.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}