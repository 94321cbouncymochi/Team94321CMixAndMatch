{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\npinFlip_motor_a = Motor(Ports.PORT3, False)\npinFlip_motor_b = Motor(Ports.PORT9, True)\npinFlip = MotorGroup(pinFlip_motor_a, pinFlip_motor_b)\nbeamClawLift_motor_a = Motor(Ports.PORT6, False)\nbeamClawLift_motor_b = Motor(Ports.PORT12, True)\nbeamClawLift = MotorGroup(beamClawLift_motor_a, beamClawLift_motor_b)\nPrimary = Pneumatic(Ports.PORT2)\nSecondary = Pneumatic(Ports.PORT8)\ncontroller = Controller()\nleft_drive_smart = Motor(Ports.PORT7, 0.6666666666666666, True)\nright_drive_smart = Motor(Ports.PORT1, 0.6666666666666666, False)\n\ndrivetrain = SmartDrive(left_drive_smart, right_drive_smart, brain_inertial, 200)\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\nvexcode_initial_drivetrain_calibration_completed = False\ndef calibrate_drivetrain():\n    # Calibrate the Drivetrain Inertial\n    global vexcode_initial_drivetrain_calibration_completed\n    if not vexcode_initial_drivetrain_calibration_completed:\n        Primary.pump_off()\n        Secondary.pump_off()\n    sleep(200, MSEC)\n    brain.screen.print(\"Calibrating\")\n    brain.screen.next_row()\n    brain.screen.print(\"Inertial\")\n    brain_inertial.calibrate()\n    while brain_inertial.is_calibrating():\n        sleep(25, MSEC)\n    if not vexcode_initial_drivetrain_calibration_completed:\n        Primary.pump_on()\n        Secondary.pump_on()\n    vexcode_initial_drivetrain_calibration_completed = True\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n\n\n# Calibrate the Drivetrain\ncalibrate_drivetrain()\n\n#endregion VEXcode Generated Robot Configuration\ni = 0\n# --------------------------------------------------\n# Claw Functions\n# --------------------------------------------------\n\ndef openRightClaw():\n    Secondary.retract(CYLINDER1)\n\ndef closeRightClaw():\n    Secondary.extend(CYLINDER1)\n\ndef openLeftClaw():\n    Primary.retract(CYLINDER1)\n\ndef closeLeftClaw():\n    Primary.extend(CYLINDER1)\n\ndef openBeamClaw():\n    Primary.extend(CYLINDER2)\n\ndef closeBeamClaw():\n    Primary.retract(CYLINDER2)\n\n# --------------------------------------------------\n# Utility / Debug\n# --------------------------------------------------\n\ndef screenPrint(text):\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(text)\n\ndef consolePrint(text):\n    print(text + \" | \" + str(brain.timer.time(SECONDS)))\n\ndef clearConsole():\n    print(\"\\033[2J\")\n\n# --------------------------------------------------\n# Robot Configuration\n# --------------------------------------------------\n\ndef config():\n    openRightClaw()\n    closeLeftClaw()\n    openBeamClaw()\n\n    drivetrain.set_drive_velocity(50, PERCENT)\n    drivetrain.set_turn_velocity(35, PERCENT)\n\n    clearConsole()\n\n# --------------------------------------------------\n# Mechanisms\n# --------------------------------------------------\n\n\ndef flip():\n    pinFlip.set_timeout(5, SECONDS)\n    pinFlip.spin_for(FORWARD, 60000, DEGREES)\n    beamClawLift.spin_for(REVERSE, 30, DEGREES)\n    wait(0.5, SECONDS)\n    openRightClaw()\n    openLeftClaw()\n    pinFlip.set_timeout(5, SECONDS)\n    pinFlip.spin_for(REVERSE, 800, DEGREES)\n\ndef twoStackLift():\n    pinFlip.spin_for(FORWARD, 240, DEGREES)\n\ndef twoStackDown():\n    pinFlip.set_timeout(1, SECONDS)\n    pinFlip.spin_for(REVERSE, 300, DEGREES)\n\n# --------------------------------------------------\n# Main / Autonomous\n# --------------------------------------------------\n\ndef main():\n    config()\n\n    while not controller.buttonFUp.pressing():\n        #----------------------Wait-for-the-controller-to-be-pressed-------------------------\n        screenPrint(\"Press F-Up to start\")\n        consolePrint(\"Waiting for start\")\n        closeLeftClaw()\n        wait(1, MSEC)\n    #---------------Drive-to-first-pin------------------\n    drivetrain.drive(FORWARD)\n    wait(6, SECONDS)\n    closeRightClaw()\n    drivetrain.stop()\n    drivetrain.drive_for(REVERSE, 150, MM)\n    for _ in range(4):\n        drivetrain.turn_to_heading(70, DEGREES)\n    twoStackLift()\n    drivetrain.drive_for(FORWARD, 400, MM)\n    drivetrain.drive_for(FORWARD, 200, MM, wait=False)\n    twoStackDown()\n    drivetrain.drive_for(REVERSE, 200, MM)\n    for _ in range(4):\n        drivetrain.turn_to_heading(180, DEGREES)\n    drivetrain.set_timeout(1, SECONDS)\n    drivetrain.drive_for(REVERSE, 500, MM)\n    closeBeamClaw()\n    flip()\n    for _ in range(4):\n        drivetrain.turn_to_heading(0, DEGREES)\n    beamClawLift.spin_for(FORWARD, 400, DEGREES)\n    \n# --------------------------------------------------\n# Controller Thread\n# --------------------------------------------------\n\ndef controllerFunctions():\n    while True:\n        if controller.buttonEDown.pressing():\n            brain.program_stop()\n        elif controller.buttonEUp.pressing():\n            consolePrint(\"\")\n        elif controller.buttonFUp.pressing():\n            wait(20, MSEC)\n\n# --------------------------------------------------\n# Start\n# --------------------------------------------------\n\nmain()\nrunControllerFunctions = Thread(controllerFunctions)","textLanguage":"python","robotConfig":[{"port":[3,9],"name":"pinFlip","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"false","motor_b_reversed":"true"},"triportSourcePort":22},{"port":[6,12],"name":"beamClawLift","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"false","motor_b_reversed":"true"},"triportSourcePort":22},{"port":[2],"name":"Primary","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"cylinder1","cylinder2":"cylinder2","cylinder1_reversed":"false","cylinder2_reversed":"false","cylinder3":"","cylinder4":""},"triportSourcePort":22},{"port":[8],"name":"Secondary","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"cylinder1","cylinder2":"cylinder2","cylinder1_reversed":"false","cylinder2_reversed":"false","cylinder3":"","cylinder4":""},"triportSourcePort":22},{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22},{"port":[7,1,0],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"200mm","gearRatio":"2:3","direction":"rev","gyroType":"integrated","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22}],"slot":2,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}